# API Keys (Optional - mock fallback is enabled if empty)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
LLM_PROVIDER=groq  # 'groq', 'gemini', 'openai', or 'mock'
RUBRIC_MODEL=openai/gpt-oss-20b
SCORING_MODEL=openai/gpt-oss-20b

# Confidence Engine Thresholds
CONFIDENCE_AUTO_ACCEPT=0.80
CONFIDENCE_SPOT_CHECK=0.50

# App Settings
DATABASE_URL=sqlite:///./data/grading_system.db
CHROMA_PERSIST_DIR=./data/chroma_db
